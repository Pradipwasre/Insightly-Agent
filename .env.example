# Fill in ONE key. The provider is picked from whichever key is set
# (Anthropic first, then OpenAI, then Groq).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional overrides
# LLM_PROVIDER=anthropic       # anthropic | openai | groq
# LLM_MODEL=claude-haiku-5-5   # anthropic default (cheapest; $0.10 / $0.50 per 1M tokens)
#                              # openai default: gpt-5.4-mini, groq default: openai/gpt-oss-120b
#                              # harder questions: LLM_MODEL=claude-sonnet-5-5 ($2 / $10)
# LLM_FAST_MODEL=              # router + memory summary; on anthropic always claude-haiku-5-5
